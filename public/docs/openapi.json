{
  "openapi": "3.0.3",
  "info": {
    "title": "PunithRaj - Job Portal API",
    "version": "1.0.0",
    "description": "JWT authentication, role-based access, jobs, applications, analytics and public job aggregation. Error response: {error, details?}. Pagination response: {page, limit, total, pages}. Scraper response: {jobs_added, duplicates_skipped, errors}."
  },
  "servers": [
    {
      "url": "https://punithraj-job-portal.punithrajkumar602.workers.dev/api"
    },
    {
      "url": "http://localhost:4173/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "talentlane_token"
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a candidate or employer",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Role or ownership denied"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Duplicate or closed job"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Rate limit or aggregation cooldown"
          },
          "503": {
            "description": "Database or service unavailable"
          },
          "201": {
            "description": "Created"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password", "role"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 10
                  },
                  "role": {
                    "type": "string",
                    "enum": ["candidate", "employer"]
                  },
                  "company": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
