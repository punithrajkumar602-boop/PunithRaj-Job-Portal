            "description": "Duplicate or closed job"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Rate limit or aggregation cooldown"
          },
          "503": {
            "description": "Database or service unavailable"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search title, company, description and skills"
          },
          {
            "name": "location",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Location substring"
          },
          {
            "name": "mode",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Remote, Hybrid, On-site"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Full-time, Part-time, Contract, Internship"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "newest, oldest, title"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Page number, default 1"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Page size, default 9; max 50"
          },
          {
            "name": "saved",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "1 to show your saved jobs (candidate login required)"
          },
          {
            "name": "owned",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "1 to show your own jobs, including closed jobs (employer login required)"
          }
        ]
      },
      "post": {
        "summary": "Create a job (employer only)",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Role or ownership denied"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Duplicate or closed job"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Rate limit or aggregation cooldown"
          },
          "503": {
            "description": "Database or service unavailable"
          },
          "201": {
            "description": "Created"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "location",
                  "work_mode",
                  "employment_type",
                  "skills",
                  "description"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 3
                  },
                  "location": {
                    "type": "string"
                  },
                  "work_mode": {
                    "type": "string",
                    "enum": ["Remote", "Hybrid", "On-site"]
                  },
                  "employment_type": {
                    "type": "string",
                    "enum": ["Full-time", "Part-time", "Contract", "Internship"]
                  },
                  "salary": {
                    "type": "string"
                  },
                  "experience": {
                    "type": "string"
                  },
                  "skills": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "description": {
                    "type": "string",
                    "minLength": 30
                  },
                  "benefits": {
                    "type": "string"
                  },
                  "deadline": {
                    "type": "string",
                    "format": "date",
                    "nullable": true
                  },
                  "status": {
                    "type": "string",
                    "enum": ["open", "closed"]
                  }
                }
              }
            }
          }
        }
      }
    },
